{
  "name": "@gpuiv/vue",
  "version": "0.5.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./single-instance": {
      "types": "./dist/single-instance.d.ts",
      "import": "./dist/single-instance.js",
      "default": "./dist/single-instance.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./automation": {
      "types": "./dist/automation/index.d.ts",
      "import": "./dist/automation/index.js",
      "default": "./dist/automation/index.js"
    },
    "./hmr": {
      "types": "./dist/hmr/index.d.ts",
      "import": "./dist/hmr/index.js",
      "default": "./dist/hmr/index.js"
    },
    "./hmr-preload": {
      "import": "./hmr-preload.js",
      "default": "./hmr-preload.js"
    }
  },
  "files": [
    "dist",
    "hmr-preload.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/liuyanghejerry/gpuiv"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuiv/vue locally. CI is the only release path. See AGENTS.md.'); process.exit(1) }\"",
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gpuiv/native": "workspace:^",
    "@vue/reactivity": "^3.5.13",
    "eventsource-parser": "^4.1.0",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-markdown": "^1.13.7",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "@vue/devtools": "^8.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.3.3",
    "@vue/devtools": "^8.2.1",
    "@vue/devtools-kit": "^8.2.1",
    "h3": "^1.15.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18",
    "vue": "^3.5.13"
  },
  "peerDependenciesMeta": {
    "@vue/devtools": {
      "optional": true
    }
  }
}
