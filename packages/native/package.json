{
  "name": "@gpuiv/native",
  "version": "0.4.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "gpuiv-native",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liuyanghejerry/gpuiv"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --features test-support",
    "build:release": "napi build --platform --release",
    "build:debug": "napi build --platform --features test-support",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuiv/native locally. CI builds all platform binaries. See AGENTS.md.'); process.exit(1) }\" && napi pre-publish -t npm --no-gh-release",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.1.3"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ]
}
