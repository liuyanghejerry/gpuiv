{
  "name": "@gpuiv/animal-island",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/liuyanghejerry/gpuiv"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc --watch",
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuiv/animal-island locally. CI is the only release path. See AGENTS.md.'); process.exit(1) }\""
  },
  "dependencies": {
    "@gpuiv/vue": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "vitest": "^4.0.18",
    "@types/node": "^25.3.3",
    "typescript": "^5.3.0",
    "vue": "^3.5.13"
  }
}
