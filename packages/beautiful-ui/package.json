{
  "name": "@gpuiv/beautiful-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "import": "./dist/motion.js",
      "default": "./dist/motion.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/liuyanghejerry/gpuiv"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node -e \"if (!process.env.CI) { console.error('Never publish @gpuiv/beautiful-ui locally. CI is the only release path.'); process.exit(1) }\"",
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@gpuiv/native": "workspace:^",
    "@gpuiv/vue": "workspace:^",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^25",
    "typescript": "^5.3",
    "vitest": "^4",
    "vue": "^3.5"
  }
}
