{
  "name": "gpuiv",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "build": "bun run build:native && bun run build:vue",
    "build:native": "cd packages/native && bun run build",
    "build:vue": "cd packages/vue && bun run build",
    "example:counter": "cd examples && bun --hot counter.tsx",
    "dev": "bun scripts/dev.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  }
}
